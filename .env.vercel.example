# Environment variables for Vercel (Project → Settings → Environment Variables).
# Hosted MySQL — e.g. TiDB Cloud Starter (free): port 4000, TLS required.
DB_HOST=gateway01.xx-xxxx-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=leadforge
DB_USER=xxxxxxxx.root
DB_PASSWORD=change-me
DB_SSL=true

# Your contact address — required by the OpenStreetMap Nominatim usage policy.
OSM_USER_AGENT=LeadForge/1.0 (contact: you@example.com)

# Optional: the public URL used in emailed links (defaults to the Vercel production URL).
# APP_URL=https://your-project.vercel.app

# Optional: send verification / password-reset emails through a free SMTP provider.
# MAIL_DRIVER=smtp
# MAIL_FROM=you@example.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=...
# SMTP_PASSWORD=...
