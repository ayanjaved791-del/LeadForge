{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "if [ ! -d frontend ]; then echo \"LeadForge: Vercel is building in $(pwd), which has no frontend/ folder. Set Project Settings > Build and Deployment > Root Directory to the repository root (leave it empty).\"; ls -la; exit 1; fi; cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build:vercel",
  "outputDirectory": "app",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "includeFiles": "api/{bootstrap.php,config.example.php,src/**}",
      "excludeFiles": "{.git/**,frontend/**,app/**,database/**,node_modules/**,api/storage/**,api/config.php,*.md,.env*}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
