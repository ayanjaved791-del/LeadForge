# Dev server (npm run dev)
VITE_BASE=/
# Where XAMPP serves the PHP API (proxied from /api during development)
LEADFORGE_API_TARGET=http://localhost
LEADFORGE_API_PATH=/leadforge/api

# Production build (npm run build) — defaults assume the repo is cloned to htdocs/leadforge
# VITE_BASE=/leadforge/app/
# VITE_API_BASE=/leadforge/api
